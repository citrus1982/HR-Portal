# ─── Database ────────────────────────────────────────────────────────────────
# MySQL connection string (Hostinger VPS)
DATABASE_URL="mysql://username:password@localhost:3306/hr_portal"

# ─── NextAuth ────────────────────────────────────────────────────────────────
NEXTAUTH_URL="https://yourdomain.com"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ─── Anthropic / Claude API ──────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Cloudflare R2 (File Storage) ────────────────────────────────────────────
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="hr-portal-files"
R2_PUBLIC_URL="https://files.yourdomain.com"

# ─── Stripe (Card Payments) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Billplz (FPX / Malaysian Bank Transfer) ─────────────────────────────────
BILLPLZ_API_KEY="your-billplz-api-key"
BILLPLZ_COLLECTION_ID="your-collection-id"
BILLPLZ_X_SIGNATURE="your-x-signature"
BILLPLZ_SANDBOX="false"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_NAME="TalentBridge"
